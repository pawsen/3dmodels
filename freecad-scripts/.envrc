FREECAD_BASE=$(dirname $(readlink -f $(which freecad)))/../
FREECAD_LIB=$FREECAD_BASE/lib
FREECAD_MOD=$FREECAD_BASE/Mod
export PYTHONPATH=${FREECAD_LIB}:${FREECAD_MOD}:$PYTHONPATH

# set the python interpreter to the one freecad links to
# Ensures that FreeCad and Python use the same glibc
# match in the format python3-3.15.3
export FREECAD_PYTHON=$(nix-store --query --references $(which freecadcmd) | grep 'python3-[0-9]\.[0-9]*\.[0-9]$')

export PYTHON_BIN=$FREECAD_PYTHON/bin/python3
export PATH=$(dirname $PYTHON_BIN):$PATH
